{
  "name": "kitsune-git",
  "version": "1.0.0-beta2",
  "description": "Lightweight, fast, universal Git GUI client — like SourceTree but faster",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "cross-env NODE_ENV=development electron .",
    "generate-icons": "node scripts/generate-icons.js",
    "prebuild:win": "npm run generate-icons",
    "prebuild:linux": "npm run generate-icons",
    "build:win": "electron-builder --win --x64",
    "build:win:arm64": "electron-builder --win --arm64",
    "build:linux": "electron-builder --linux --x64",
    "build:linux:arm64": "electron-builder --linux --arm64",
    "build:mac": "electron-builder --mac",
    "build:all": "npm run generate-icons && electron-builder --win --linux",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "release": "npm run generate-icons && electron-builder --win --linux --publish always",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "appId": "com.kitsune.git",
    "productName": "KitsuneGIT",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icon.ico",
      "publisherName": "KitsuneGIT"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        },
        {
          "target": "deb",
          "arch": ["x64"]
        },
        {
          "target": "rpm",
          "arch": ["x64"]
        },
        {
          "target": "tar.gz",
          "arch": ["x64"]
        }
      ],
      "icon": "build/icons",
      "category": "Development",
      "maintainer": "KitsuneGIT Team",
      "synopsis": "Fast Git GUI client",
      "description": "Lightweight, fast, universal Git GUI client — like SourceTree but faster",
      "desktop": {
        "Name": "KitsuneGIT",
        "Comment": "Fast Git GUI Client",
        "Categories": "Development;RevisionControl;",
        "Keywords": "git;vcs;version control;gui;",
        "StartupWMClass": "kitsune-git",
        "MimeType": "x-scheme-handler/kitsunegit;"
      }
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "KitsuneGIT",
      "uninstallDisplayName": "KitsuneGIT",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "license": "LICENSE"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "OWNER",
        "repo": "KitsuneGIT"
      }
    ]
  },
  "keywords": [
    "git",
    "gui",
    "electron",
    "sourcetree",
    "version-control"
  ],
  "author": "KitsuneGIT Team",
  "license": "MIT",
  "devDependencies": {
    "cross-env": "^7.0.3",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "chokidar": "^4.0.0",
    "electron-updater": "^6.3.0",
    "simple-git": "^3.27.0"
  }
}
