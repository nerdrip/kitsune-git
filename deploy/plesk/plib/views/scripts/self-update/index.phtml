<?php
$e = static function ($value) { return htmlspecialchars((string) $value, ENT_QUOTES, 'UTF-8'); };
$installed = (array) $this->installed;
$state = (array) $this->updateState;
$source = (array) $this->updateSource;
$status = (string) ($state['status'] ?? 'unchecked');
$available = $status === 'available';
$label = $available ? 'Dostępna aktualizacja' : ($status === 'current' || $status === 'updated' ? 'Wersja aktualna' : ($status === 'failed' ? 'Błąd sprawdzania' : 'Nie sprawdzono'));
?>
<div data-kitsune-suite data-suite-product="<?php echo $e($installed['name']); ?>" data-suite-version="<?php echo $e($installed['version'] . '-r' . $installed['release']); ?>" data-suite-hub="<?php echo $this->suiteHubActive ? '1' : '0'; ?>"></div>
<main class="kitsune-self-update">
  <header class="kitsune-self-update-hero"><div><span>AKTUALIZACJA ROZSZERZENIA PLESKA</span><h1><?php echo $e($installed['name']); ?></h1><p>Manager synchronizuje prywatny checkout skonfigurowanego repozytorium, sprawdza <code>meta.xml</code> z gałęzi <code><?php echo $e($source['branch'] ?? 'main'); ?></code> i instaluje paczkę z przypiętego commitu.</p></div><a class="kitsune-self-button" href="<?php echo $e($this->pluginUrl); ?>">← Wróć do konfiguracji</a></header>
  <?php if (!empty($state['error'])): ?><div class="kitsune-self-alert is-error"><strong>Operacja nie powiodła się</strong><span><?php echo $e($state['error']); ?></span></div><?php endif; ?>
  <section class="kitsune-self-card">
    <div class="kitsune-self-status"><div><small>STAN AKTUALIZACJI</small><strong><?php echo $e($label); ?></strong><span><?php echo !empty($state['checkedAt']) ? 'Sprawdzono ' . $e($state['checkedAt']) : 'Repozytorium nie było jeszcze sprawdzane.'; ?></span></div><i class="is-<?php echo $e($status); ?>"></i></div>
    <div class="kitsune-self-versions"><article><span>Wersja zainstalowana</span><strong><?php echo $e($installed['version']); ?>-r<?php echo $e($installed['release']); ?></strong><small>Aktywna w tym panelu Plesk</small></article><article class="<?php echo $available ? 'has-update' : ''; ?>"><span>Wersja w repozytorium</span><strong><?php echo !empty($state['remoteVersion']) ? $e($state['remoteVersion']) . '-r' . $e($state['remoteRelease']) : 'Nie sprawdzono'; ?></strong><small><?php echo $e($source['branch'] ?? 'main'); ?> · <?php echo $e($source['path'] ?? ''); ?><?php echo !empty($state['repositoryCommit']) ? ' · ' . $e(substr($state['repositoryCommit'], 0, 12)) : ''; ?></small></article></div>
    <div class="kitsune-self-actions"><form method="post" action="<?php echo $e(pm_Context::getActionUrl('self-update', 'check')); ?>"><button class="kitsune-self-button" type="submit">↻ Synchronizuj repozytorium i sprawdź</button></form><form method="post" action="<?php echo $e(pm_Context::getActionUrl('self-update', 'update')); ?>"><button class="kitsune-self-button is-primary" type="submit" <?php echo $available ? '' : 'disabled aria-disabled="true"'; ?> onclick="return confirm('Zbudować paczkę z przypiętego commitu i zainstalować aktualizację?')"><?php echo $available ? 'Zaktualizuj do ' . $e($state['remoteVersion']) . '-r' . $e($state['remoteRelease']) : 'Brak nowszej wersji'; ?></button></form></div>
  </section>
  <p class="kitsune-self-footnote">Kitsune Hub może dodatkowo aktualizować wszystkie managery zbiorczo. Ten ekran pozostaje niezależny i jest dostępny bez Huba.</p>
</main>
